---
const { t } = Astro.props;
---

<section id="skills" class="section-alt py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-16">
      <span class="font-mono text-ocean-400 text-xs tracking-[0.2em] uppercase">{t.label}</span>
      <h2 class="font-display font-bold text-white text-3xl md:text-4xl mt-2">
        {t.title}
      </h2>
    </div>

    <!-- Primary skills -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
      {t.primary.map((skill: any) => (
        <div class="bg-navy-800 border border-navy-700 rounded-xl p-5 card-hover group">
          <div class="text-2xl mb-3 text-ocean-400/70 group-hover:text-ocean-400 transition-colors">
            {skill.icon}
          </div>
          <h3 class="font-display font-semibold text-white text-sm mb-2">{skill.name}</h3>
          <p class="text-slate-500 text-xs leading-relaxed">{skill.description}</p>
        </div>
      ))}
    </div>

    <!-- Secondary / previous stack -->
    <div class="mb-14">
      <p class="font-mono text-slate-500 text-xs tracking-widest uppercase mb-4">
        {t.secondaryLabel}
      </p>
      <div class="flex flex-wrap gap-2">
        {t.secondary.map((s: string) => (
          <span class="font-mono text-xs text-slate-500 bg-navy-800 border border-navy-700 px-3 py-1.5 rounded-lg">
            {s}
          </span>
        ))}
      </div>
    </div>

    <!-- Soft skills / working style -->
    <div>
      <p class="font-mono text-slate-500 text-xs tracking-widest uppercase mb-6">
        {t.softLabel}
      </p>
      <div class="space-y-0">
        {t.soft.map((item: any) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-5 py-4 border-b border-navy-700 last:border-0">
            <span class="font-mono text-ocean-400 text-xs tracking-wide shrink-0 sm:w-52">{item.name}</span>
            <p class="text-slate-400 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
