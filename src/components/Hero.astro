---
const { t } = Astro.props;
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">

  <!-- Nautical grid -->
  <div class="absolute inset-0 nautical-grid"></div>

  <!-- Radial glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(0,180,216,0.05) 0%, transparent 70%);"
  ></div>

  <!-- Ship's wheel (helm) — ghost element, top right -->
  <div
    class="absolute -right-24 top-1/2 -translate-y-1/2 w-[560px] h-[560px] text-ocean-500 pointer-events-none select-none animate-spin-slow"
    style="opacity: 0.05;"
    aria-hidden="true"
  >
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
      <!-- Outer rim — thick with inner edge detail -->
      <circle cx="100" cy="100" r="87" stroke="currentColor" stroke-width="6"/>
      <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1.2"/>
      <!-- Center hub -->
      <circle cx="100" cy="100" r="20" stroke="currentColor" stroke-width="4"/>
      <circle cx="100" cy="100" r="12" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="100" cy="100" r="6" fill="currentColor"/>
      <!-- Cardinal spokes (hub edge r=20 → just past inner rim r=80) -->
      <line x1="100" y1="80" x2="100" y2="13" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="100" y1="120" x2="100" y2="187" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="80" y1="100" x2="13" y2="100" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="120" y1="100" x2="187" y2="100" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <!-- Diagonal spokes (hub edge at 45°≈±14 → rim at 45°≈±62) -->
      <line x1="86" y1="86" x2="38" y2="38" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="114" y1="114" x2="162" y2="162" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="114" y1="86" x2="162" y2="38" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="86" y1="114" x2="38" y2="162" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
      <!-- Handle knobs — cardinal (r≈96 from center) -->
      <circle cx="100" cy="4" r="7" fill="currentColor"/>
      <circle cx="100" cy="196" r="7" fill="currentColor"/>
      <circle cx="4" cy="100" r="7" fill="currentColor"/>
      <circle cx="196" cy="100" r="7" fill="currentColor"/>
      <!-- Handle knobs — diagonal (r≈96, offset≈68) → coords ≈ 32 or 168 -->
      <circle cx="32" cy="32" r="7" fill="currentColor"/>
      <circle cx="168" cy="168" r="7" fill="currentColor"/>
      <circle cx="168" cy="32" r="7" fill="currentColor"/>
      <circle cx="32" cy="168" r="7" fill="currentColor"/>
    </svg>
  </div>

  <!-- Wave lines — subtle nautical texture -->
  <div
    class="absolute bottom-32 left-0 right-0 pointer-events-none text-ocean-500"
    style="opacity: 0.04;"
    aria-hidden="true"
  >
    <svg viewBox="0 0 1200 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full">
      <path d="M0,30 C100,50 200,10 300,30 S500,50 600,30 S800,10 900,30 S1100,50 1200,30" stroke="currentColor" stroke-width="1.5" fill="none"/>
      <path d="M0,42 C120,22 240,58 360,42 S560,22 720,42 S920,62 1080,42 S1160,22 1200,42" stroke="currentColor" stroke-width="1" fill="none"/>
    </svg>
  </div>

  <!-- Bottom gradient fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-40 pointer-events-none"
    style="background: linear-gradient(to top, #050d1a, transparent);"
  ></div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-6 pt-28 pb-20 w-full">
    <div class="max-w-3xl">

      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-8">
        <span class="w-8 h-px bg-ocean-500"></span>
        <span class="font-mono text-ocean-400 text-xs tracking-[0.2em] uppercase">
          {t.eyebrow}
        </span>
      </div>

      <!-- Name -->
      <h1 class="font-display font-bold text-white leading-[1.05] mb-6">
        <span class="block text-5xl md:text-6xl lg:text-7xl">Juan Luis</span>
        <span class="block text-5xl md:text-6xl lg:text-7xl text-gradient">Soto</span>
      </h1>

      <!-- Tagline -->
      <p class="text-lg md:text-xl text-slate-400 leading-relaxed mb-10 max-w-xl">
        {t.tagline}
      </p>

      <!-- Status -->
      <div class="flex items-center gap-2 mb-10 text-sm text-slate-500 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse-slow inline-block"></span>
        <span set:html={t.statusHtml} />
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://github.com/grandeotos"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-ocean-500 text-navy-900 font-semibold rounded-lg hover:bg-ocean-400 transition-colors duration-200 text-sm"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/grandeotos"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 border border-ocean-500/40 text-ocean-400 font-semibold rounded-lg hover:bg-ocean-500/10 transition-colors duration-200 text-sm"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <a
          href={t.cvHref}
          class="inline-flex items-center gap-2 px-6 py-3 border border-ocean-500/40 text-ocean-400 font-semibold rounded-lg hover:bg-ocean-500/10 transition-colors duration-200 text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          {t.ctaCv}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 text-slate-400 hover:text-white transition-colors duration-200 font-medium text-sm"
        >
          {t.ctaContact}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600">
    <span class="text-xs font-mono tracking-[0.2em] uppercase">{t.scroll}</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>

</section>
