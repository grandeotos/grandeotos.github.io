---
const { t } = Astro.props;
---

<section id="experience" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-16">
      <span class="font-mono text-ocean-400 text-xs tracking-[0.2em] uppercase">{t.label}</span>
      <h2 class="font-display font-bold text-white text-3xl md:text-4xl mt-2">
        {t.title}
      </h2>
    </div>

    <!-- Work timeline -->
    <div class="relative">
      <div class="absolute left-0 top-0 bottom-0 w-px bg-navy-700 hidden md:block ml-2"></div>

      <div class="space-y-8">
        {t.jobs.map((job: any) => (
          <div class="md:pl-12 relative">
            <div class={`absolute left-0 top-1 w-5 h-5 rounded-full border-2 hidden md:flex items-center justify-center ${job.current ? 'border-ocean-500 bg-navy-900' : 'border-navy-600 bg-navy-800'}`}>
              {job.current && <span class="w-2 h-2 rounded-full bg-ocean-500 animate-pulse-slow"></span>}
            </div>

            <div class={`border rounded-xl p-6 card-hover ${job.minimal ? 'bg-navy-800/50 border-navy-700/60' : 'bg-navy-800 border-navy-700'}`}>

              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                <div>
                  <h3 class="font-display font-semibold text-white text-lg">
                    {job.role}
                    {job.current && (
                      <span class="ml-2 text-xs font-mono text-ocean-400 bg-ocean-500/10 border border-ocean-500/20 px-2 py-0.5 rounded-full align-middle">
                        {t.currentLabel}
                      </span>
                    )}
                  </h3>
                  <p class="text-ocean-400 font-medium text-sm mt-0.5">
                    {job.companyUrl ? (
                      <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="hover:text-ocean-300 transition-colors">
                        {job.company}
                      </a>
                    ) : job.company}
                  </p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-slate-400 text-sm font-mono">{job.period}</p>
                  <p class="text-slate-600 text-xs mt-0.5">{job.type}</p>
                </div>
              </div>

              <p class="text-slate-400 text-sm leading-relaxed mb-4">{job.description}</p>

              {!job.minimal && (
                <ul class="space-y-2 mb-5">
                  {job.highlights.map((h: string) => (
                    <li class="flex items-start gap-2 text-sm text-slate-400">
                      <span class="text-ocean-500 mt-1 shrink-0">›</span>
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              <div class="flex flex-wrap gap-2">
                {job.tech.map((tech: string) => (
                  <span class="text-xs font-mono text-slate-500 bg-navy-700 px-2.5 py-1 rounded-md border border-navy-600">
                    {tech}
                  </span>
                ))}
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education + Faraday + Certs + Languages -->
    <div class="grid md:grid-cols-2 gap-10 mt-20">

      <!-- Education -->
      <div>
        <h3 class="font-display font-semibold text-white text-xl mb-6 flex items-center gap-3">
          <span class="w-6 h-px bg-ocean-500/50"></span>
          {t.educationTitle}
        </h3>
        <div class="space-y-5">
          {t.education.map((e: any) => (
            <div class="border-l-2 border-navy-700 pl-5">
              <p class="text-white font-medium text-sm">{e.degree}</p>
              <p class="text-ocean-400 text-sm mt-0.5">{e.institution}</p>
              <p class="text-slate-500 text-xs font-mono mt-1">{e.period} · {e.note}</p>
            </div>
          ))}
        </div>

        <!-- Faraday 5696 -->
        <div class="mt-8 bg-navy-800 border border-navy-700 rounded-xl p-5">
          <div class="flex items-start justify-between gap-2 mb-3">
            <div>
              <p class="text-white font-medium text-sm">{t.faraday.team}</p>
              <p class="text-ocean-400 text-xs mt-0.5">{t.faraday.institution} · {t.faraday.period}</p>
            </div>
            <span class="text-xs font-mono text-slate-500 shrink-0">{t.faraday.role}</span>
          </div>
          <ul class="space-y-1.5">
            {t.faraday.highlights.map((h: string) => (
              <li class="flex items-center gap-2 text-xs text-slate-400">
                <span class="text-ocean-500 shrink-0">›</span>
                {h}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Certs + Languages -->
      <div class="space-y-10">

        <div>
          <h3 class="font-display font-semibold text-white text-xl mb-6 flex items-center gap-3">
            <span class="w-6 h-px bg-ocean-500/50"></span>
            {t.certificationsTitle}
          </h3>
          <div class="space-y-4">
            {t.certifications.map((c: any) => (
              <div class="flex items-start gap-4">
                <span class="text-ocean-500 text-lg mt-0.5 shrink-0">◈</span>
                <div>
                  <p class="text-white text-sm font-medium">{c.name}</p>
                  <p class="text-slate-500 text-xs font-mono mt-0.5">{c.issuer} · {c.date}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="font-display font-semibold text-white text-xl mb-6 flex items-center gap-3">
            <span class="w-6 h-px bg-ocean-500/50"></span>
            {t.languagesTitle}
          </h3>
          <div class="space-y-3">
            {t.languages.map((l: any) => (
              <div class="flex items-center gap-4">
                <span class="text-white text-sm font-medium w-20 shrink-0">{l.lang}</span>
                <span class="text-slate-400 text-sm">{l.level}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
