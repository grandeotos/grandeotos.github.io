---
const { t } = Astro.props;
---

<section id="about" class="section-alt py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-16">
      <span class="font-mono text-ocean-400 text-xs tracking-[0.2em] uppercase">{t.label}</span>
      <h2 class="font-display font-bold text-white text-3xl md:text-4xl mt-2">
        {t.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- Bio -->
      <div class="space-y-5">
        <p class="text-slate-300 leading-relaxed" set:html={t.bio1Html} />
        <p class="text-slate-400 leading-relaxed" set:html={t.bio2Html} />
        <p class="text-slate-400 leading-relaxed" set:html={t.bio3Html} />

        <!-- CV download -->
        <div class="pt-4 border-t border-navy-700 flex items-center gap-4">
          <a
            href="/cv-juan-luis-soto.pdf"
            download
            class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-ocean-400 transition-colors font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {t.cv}
          </a>
          <span class="text-slate-600 text-xs font-mono">{t.comment}</span>
        </div>
      </div>

      <!-- Quick facts -->
      <div class="space-y-3">
        {t.facts.map((fact: { label: string; value: string; href?: string }) => (
          <div class="flex items-start gap-4 py-3 border-b border-navy-700 last:border-0">
            <span class="text-ocean-400 font-mono text-xs tracking-widest uppercase w-24 shrink-0 pt-0.5">
              {fact.label}
            </span>
            {fact.href ? (
              <a href={fact.href} class="text-slate-300 hover:text-ocean-400 transition-colors text-sm">
                {fact.value}
              </a>
            ) : (
              <span class="text-slate-300 text-sm">{fact.value}</span>
            )}
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
