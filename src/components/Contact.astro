---
const { t } = Astro.props;
---

<section id="contact" class="section-alt py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-16">
      <span class="font-mono text-ocean-400 text-xs tracking-[0.2em] uppercase">{t.label}</span>
      <h2 class="font-display font-bold text-white text-3xl md:text-4xl mt-2">
        {t.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">

      <div>
        <p class="text-slate-300 leading-relaxed text-lg mb-4" set:html={t.cta1Html} />
        <p class="text-slate-500 leading-relaxed">
          {t.cta2}
        </p>

        <!-- Nautical sign-off -->
        <div class="mt-8 pt-6 border-t border-navy-700">
          <p class="font-mono text-slate-600 text-xs tracking-wide">
            {t.signoff}
          </p>
        </div>
      </div>

      <div class="space-y-4">
        {t.links.map((link: any) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="flex items-center gap-5 bg-navy-800 border border-navy-700 rounded-xl p-5 card-hover group"
          >
            <div class="w-10 h-10 rounded-lg bg-ocean-500/10 border border-ocean-500/20 flex items-center justify-center shrink-0 group-hover:bg-ocean-500/20 transition-colors">
              {link.icon === 'mail' && (
                <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg class="w-5 h-5 text-ocean-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {link.icon === 'github' && (
                <svg class="w-5 h-5 text-ocean-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {link.icon === 'x' && (
                <svg class="w-4 h-4 text-ocean-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
            </div>

            <div class="flex-1 min-w-0">
              <p class="text-slate-500 text-xs font-mono tracking-widest uppercase mb-0.5">{link.label}</p>
              <p class="text-white text-sm font-medium truncate">{link.value}</p>
            </div>

            <svg class="w-4 h-4 text-slate-600 group-hover:text-ocean-400 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>
